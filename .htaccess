<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Apache strips the Authorization header before PHP sees it. Pass it through so the
    # vendor API (Bearer keys, /api/v1/vendor) can authenticate.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # API requests -> index.php
    RewriteRule ^api/ index.php [L]

    # Serve existing files directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback - all other routes -> index.html
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # HSTS - force HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'"

    # Remove PHP version exposure
    Header unset X-Powered-By
</IfModule>

<IfModule mod_headers.c>
    # The SPA shell is the only document that names the content-hashed bundles, so it
    # must never be served from cache without revalidation. Without this header browsers
    # fall back to heuristic caching, pin an old index.html, and the stale bundles it
    # references can never be pruned. Assets are immutable and cached in assets/.htaccess.
    <Files "index.html">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>
</IfModule>

# Disable directory listing
Options -Indexes

# Deny access to sensitive files
<FilesMatch "\.(sql|env|log|md|lock)$">
    Require all denied
</FilesMatch>
