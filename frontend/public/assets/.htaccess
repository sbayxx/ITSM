<IfModule mod_headers.c>
    # Vite emits content-hashed filenames, so a given URL's bytes never change.
    # Caching them for a year lets the bundles in here be pruned freely - the shell
    # (index.html) is no-cache, so it always points at the current hashes.
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>

Options -Indexes
